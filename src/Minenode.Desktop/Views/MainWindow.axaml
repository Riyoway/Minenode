<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Minenode.Desktop.Controls"
        x:Class="Minenode.Desktop.Views.MainWindow"
        Title="Minenode"
        Width="1440"
        Height="900"
        MinWidth="980"
        MinHeight="640"
        Background="#0D0D0D">
  <Grid RowDefinitions="52,*,180" ColumnDefinitions="220,*,300">
    <Border Grid.Row="0" Grid.ColumnSpan="3" BorderBrush="#262626" BorderThickness="0,0,0,1" Background="#121212">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="Minenode" FontSize="18" FontWeight="SemiBold" Margin="0,0,10,0" />
          <Button Content="New" Click="New_Click" />
          <Button Content="Import" Click="Import_Click" />
          <Button Content="Save" Click="Save_Click" />
          <Button Content="Export" Click="Export_Click" />
          <Button Content="Delete node" Click="Delete_Click" />
        </StackPanel>

        <TextBlock x:Name="DocumentNameText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" Text="Untitled" />

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="Run" Click="Run_Click" />
          <Button Content="Stop" Click="Stop_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Grid.Column="0" BorderBrush="#262626" BorderThickness="0,0,1,0" Background="#101010" Padding="12">
      <ScrollViewer>
        <StackPanel x:Name="PalettePanel" Spacing="6" />
      </ScrollViewer>
    </Border>

    <controls:NodeCanvas x:Name="EditorCanvas" Grid.Row="1" Grid.Column="1" />

    <Border Grid.Row="1" Grid.Column="2" BorderBrush="#262626" BorderThickness="1,0,0,0" Background="#101010" Padding="14">
      <ScrollViewer>
        <StackPanel x:Name="InspectorPanel" Spacing="8">
          <TextBlock Text="Inspector" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="Select a node to edit its settings." Opacity="0.55" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border Grid.Row="2" Grid.ColumnSpan="3" BorderBrush="#262626" BorderThickness="0,1,0,0" Background="#0F0F0F" Padding="12">
      <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Runtime / editor log" FontWeight="SemiBold" />
          <TextBlock x:Name="StatusText" Grid.Column="1" Text="Ready" Opacity="0.6" />
        </Grid>
        <TextBox x:Name="LogBox"
                 Grid.Row="1"
                 Margin="0,8,0,0"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas, Menlo, monospace" />
      </Grid>
    </Border>
  </Grid>
</Window>
