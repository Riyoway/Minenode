<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Minenode.Desktop.Controls"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="Minenode.Desktop.Views.MainWindow"
        Title="Minenode"
        Width="1520"
        Height="940"
        MinWidth="1080"
        MinHeight="680"
        Background="{DynamicResource MnBackgroundBrush}"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="42">
  <Grid RowDefinitions="42,*">
    <!-- Custom native title bar -->
    <Border Grid.Row="0"
            Background="#0D1014"
            BorderBrush="{DynamicResource MnBorderBrush}"
            BorderThickness="0,0,0,1"
            WindowDecorationProperties.ElementRole="TitleBar">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="10,0,4,0">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
          <Border Width="24" Height="24" CornerRadius="7" Background="{DynamicResource MnAccentMutedBrush}">
            <TextBlock Text="M" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource MnAccentBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="Minenode" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>

        <Border Grid.Column="1" Width="1" Height="18" Background="{DynamicResource MnBorderBrush}" Margin="14,0" />

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="Workflow" Classes="muted" FontSize="11" />
          <materialIcons:MaterialIcon Kind="ChevronRight" Width="12" Height="12" Foreground="{DynamicResource MnTextMutedBrush}" />
          <TextBlock x:Name="DocumentNameText" Text="Untitled" FontSize="11" FontWeight="SemiBold" />
        </StackPanel>

        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Margin="0,0,8,0">
          <Border Width="7" Height="7" CornerRadius="4" Background="{DynamicResource MnSuccessBrush}" />
          <TextBlock x:Name="StatusText" Text="Ready" Classes="muted" FontSize="11" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
          <Button Classes="titleButton" ToolTip.Tip="Minimize" Click="Minimize_Click">
            <materialIcons:MaterialIcon Kind="WindowMinimize" Width="15" Height="15" />
          </Button>
          <Button Classes="titleButton" ToolTip.Tip="Maximize or restore" Click="Maximize_Click">
            <materialIcons:MaterialIcon Kind="WindowMaximize" Width="14" Height="14" />
          </Button>
          <Button Classes="titleButton close" ToolTip.Tip="Close" Click="Close_Click">
            <materialIcons:MaterialIcon Kind="Close" Width="15" Height="15" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="58,238,*,316" RowDefinitions="*,190">
      <!-- File/action rail -->
      <Border Grid.RowSpan="2" Grid.Column="0"
              Background="#0D1014"
              BorderBrush="{DynamicResource MnBorderBrush}"
              BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*,Auto" Margin="8,12">
          <StackPanel Spacing="6">
            <Button Classes="railButton" ToolTip.Tip="New workflow" Click="New_Click">
              <materialIcons:MaterialIcon Kind="Plus" Width="20" Height="20" />
            </Button>
            <Button Classes="railButton" ToolTip.Tip="Import workflow" Click="Import_Click">
              <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="20" Height="20" />
            </Button>
            <Button Classes="railButton" ToolTip.Tip="Save workflow" Click="Save_Click">
              <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="20" Height="20" />
            </Button>
            <Button Classes="railButton" ToolTip.Tip="Export workflow" Click="Export_Click">
              <materialIcons:MaterialIcon Kind="ExportVariant" Width="20" Height="20" />
            </Button>
          </StackPanel>

          <StackPanel Grid.Row="2" Spacing="6">
            <Button Classes="railButton" ToolTip.Tip="Delete selected node" Click="Delete_Click">
              <materialIcons:MaterialIcon Kind="DeleteOutline" Width="20" Height="20" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Node library -->
      <Border Grid.RowSpan="2" Grid.Column="1"
              Background="{DynamicResource MnSurfaceBrush}"
              BorderBrush="{DynamicResource MnBorderBrush}"
              BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,Auto,*" Margin="14,14,12,12">
          <StackPanel Grid.Row="0" Spacing="3" Margin="2,0,2,12">
            <TextBlock Text="NODE LIBRARY" Classes="sectionLabel" />
            <TextBlock Text="Build a workflow by connecting small Minecraft actions." Classes="muted"
                       FontSize="11" TextWrapping="Wrap" />
          </StackPanel>

          <Grid Grid.Row="1" Margin="0,0,0,10">
            <TextBox x:Name="NodeSearchBox"
                     Watermark="Search nodes"
                     TextChanged="NodeSearch_TextChanged"
                     Padding="34,8,10,8" />
            <materialIcons:MaterialIcon Kind="Magnify" Width="16" Height="16"
                                        Margin="11,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False"
                                        Foreground="{DynamicResource MnTextMutedBrush}" />
          </Grid>

          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PalettePanel" Spacing="2" />
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- Main workflow workspace -->
      <Border Grid.Row="0" Grid.Column="2"
              Margin="12,12,10,10"
              Classes="surface"
              ClipToBounds="True">
        <Grid RowDefinitions="48,*">
          <Border Grid.Row="0" BorderBrush="{DynamicResource MnBorderBrush}" BorderThickness="0,0,0,1"
                  Background="#13171C">
            <Grid ColumnDefinitions="*,Auto" Margin="14,0,10,0">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <materialIcons:MaterialIcon Kind="GraphOutline" Width="18" Height="18" Foreground="{DynamicResource MnTextMutedBrush}" />
                <StackPanel Spacing="0">
                  <TextBlock Text="Workflow canvas" FontSize="12" FontWeight="SemiBold" />
                  <TextBlock Text="Connect output ports to compatible input ports" FontSize="10" Classes="muted" />
                </StackPanel>
              </StackPanel>

              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <Button Classes="stop" Click="Stop_Click" ToolTip.Tip="Stop workflow">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <materialIcons:MaterialIcon Kind="Stop" Width="15" Height="15" />
                    <TextBlock Text="Stop" />
                  </StackPanel>
                </Button>
                <Button Classes="primary" Click="Run_Click" ToolTip.Tip="Run workflow">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <materialIcons:MaterialIcon Kind="Play" Width="15" Height="15" />
                    <TextBlock Text="Run" Foreground="#09111E" FontWeight="SemiBold" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </Border>

          <controls:NodeCanvas x:Name="EditorCanvas" Grid.Row="1" />
        </Grid>
      </Border>

      <!-- Inspector -->
      <Border Grid.Row="0" Grid.Column="3"
              Margin="0,12,12,10"
              Classes="surface"
              ClipToBounds="True">
        <Grid RowDefinitions="48,*">
          <Border Grid.Row="0" Background="#13171C" BorderBrush="{DynamicResource MnBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center" Margin="14,0">
              <materialIcons:MaterialIcon Kind="TuneVariant" Width="17" Height="17" Foreground="{DynamicResource MnTextMutedBrush}" />
              <TextBlock Text="Inspector" FontSize="12" FontWeight="SemiBold" />
            </StackPanel>
          </Border>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="InspectorPanel" Spacing="8" Margin="14">
              <TextBlock Text="Nothing selected" FontSize="13" FontWeight="SemiBold" />
              <TextBlock Text="Select a node on the canvas to edit its configuration." Classes="muted"
                         FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- Runtime log -->
      <Border Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
              Margin="12,0,12,12"
              Classes="surface"
              ClipToBounds="True">
        <Grid RowDefinitions="40,*">
          <Border Grid.Row="0" Background="#13171C" BorderBrush="{DynamicResource MnBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto" Margin="12,0,8,0">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <materialIcons:MaterialIcon Kind="ConsoleLine" Width="16" Height="16" Foreground="{DynamicResource MnTextMutedBrush}" />
                <TextBlock Text="Runtime log" FontSize="11" FontWeight="SemiBold" />
              </StackPanel>
              <Button Grid.Column="1" Classes="iconButton" Width="32" Height="32" MinHeight="32"
                      ToolTip.Tip="Clear log" Click="ClearLog_Click">
                <materialIcons:MaterialIcon Kind="Broom" Width="15" Height="15" />
              </Button>
            </Grid>
          </Border>
          <TextBox x:Name="LogBox"
                   Grid.Row="1"
                   Margin="10"
                   IsReadOnly="True"
                   AcceptsReturn="True"
                   TextWrapping="NoWrap"
                   HorizontalScrollBarVisibility="Auto"
                   VerticalScrollBarVisibility="Auto"
                   BorderThickness="0"
                   Background="Transparent"
                   Padding="4"
                   FontFamily="Cascadia Mono, Consolas, Menlo, monospace"
                   FontSize="11" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
